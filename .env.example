# Base de données Neon (Postgres) — Décision #4
# Chaîne de connexion "pooled" fournie par Neon.
NUXT_DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/homequest?sslmode=require"

# Secret de session nuxt-auth-utils — Décision #9 (min. 32 caractères)
# Générer : openssl rand -base64 32
NUXT_SESSION_PASSWORD="change-me-please-32-chars-minimum-secret"
