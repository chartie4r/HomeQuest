# Base de données SQLite via libSQL — Décision #4
# Self-host : fichier local (créé automatiquement). Aucune dépendance externe.
# Base distante éventuelle : libsql://<db>.turso.io (+ NUXT_DATABASE_AUTH_TOKEN)
NUXT_DATABASE_URL="file:./data/homequest.db"

# Secret de session nuxt-auth-utils — Décision #9 (min. 32 caractères)
# Générer : openssl rand -base64 32
NUXT_SESSION_PASSWORD="change-me-please-32-chars-minimum-secret"
